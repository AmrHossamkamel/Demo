# Copy this file to /opt/botify-demo/.env. Do not commit real credentials.
HOST=127.0.0.1
PORT=4100
ENVIRONMENT=production
TARGETS_STORE_PATH=/opt/botify-demo/data/targets.json
DATABASE_URL=sqlite:////opt/botify-demo/data/history.db
SPLUNK_ENABLED=false
DYNATRACE_ENABLED=false
BOTIFY_AGENT_TOKEN=replace-with-a-long-random-token


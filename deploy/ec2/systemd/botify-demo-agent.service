[Unit]
Description=Botify Demo EC2 workload agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=botify
Group=botify
WorkingDirectory=/opt/botify-demo/ec2-agent
EnvironmentFile=/opt/botify-demo/ec2-agent/.env
ExecStart=/usr/bin/node /opt/botify-demo/ec2-agent/dist/index.js
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/botify-demo/ec2-agent/tmp-workloads

[Install]
WantedBy=multi-user.target

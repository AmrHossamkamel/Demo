# Server configuration
HOST=127.0.0.1
PORT=4100

# Authentication - set a secure random token (never use defaults in production)
AGENT_AUTH_TOKEN=CHANGE_ME_TO_A_SECURE_RANDOM_TOKEN

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:3000

# Disk workload configuration
DISK_TEMP_DIR=./tmp-workloads
DISK_HARD_CAP_MB=1024

# HTTP workload allow-list (comma-separated hostnames)
HTTP_ALLOW_LIST=example.com,httpbin.org

# Logging level: debug, info, warn, error
LOG_LEVEL=info

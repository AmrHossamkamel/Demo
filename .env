# Botify Observability Demo Testing Platform Configuration

HOST=0.0.0.0
PORT=9000
DEMO_APP_PORT=9090
ENVIRONMENT=development

EC2_HOST_NAME=ec2-botify-demo-node
EC2_HOST_IP=127.0.0.1

SPLUNK_HEC_URL=http://localhost:8088/services/collector/event
SPLUNK_HEC_TOKEN=demo-splunk-hec-token
SPLUNK_INDEX=main
SPLUNK_LOG_FILE_PATH=./data/logs/splunk_events.log
SPLUNK_CSV_FILE_PATH=./data/logs/splunk_events.csv
SPLUNK_ENABLED=true

DYNATRACE_TENANT_URL=http://localhost:9999
DYNATRACE_API_TOKEN=demo-dt-token
DYNATRACE_ENABLED=true

MAX_SCENARIO_DURATION_SECONDS=300
MAX_CPU_LOAD_PERCENT=75
MAX_MEMORY_ALLOCATION_MB=1024
MAX_REQUESTS_PER_SECOND=200

DATABASE_URL=sqlite:///./data/history.db

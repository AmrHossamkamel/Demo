```yaml
name: Security CI/CD

on:
  push:
    branches:
      - "**"

  pull_request:
    branches:
      - main
      - master

  workflow_dispatch:

permissions:
  contents: read
  security-events: write
  pull-requests: write

# Prevent multiple security scans for the same branch/PR
concurrency:
  group: security-${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: true

jobs:

  # ============================================================
  # 1. SEMGREP - SAST
  # ============================================================
  semgrep:
    name: Semgrep SAST
    runs-on: ubuntu-latest

    steps:
      - name: Checkout repository
        uses: actions/checkout@v6
        with:
          fetch-depth: 0

      - name: Run Semgrep
        uses: semgrep/semgrep-action@v1
        with:
          config: >-
            p/security-audit
            p/owasp-top-ten
          auditOn: push
          generateSarif: true

      - name: Upload Semgrep SARIF
        if: always()
        uses: github/codeql-action/upload-sarif@v4
        with:
          sarif_file: semgrep.sarif


  # ============================================================
  # 2. GITLEAKS - SECRET SCANNING
  # ============================================================
  gitleaks:
    name: Gitleaks Secrets Scan
    runs-on: ubuntu-latest

    steps:
      - name: Checkout repository
        uses: actions/checkout@v6
        with:
          fetch-depth: 0

      - name: Run Gitleaks
        uses: gitleaks/gitleaks-action@v3
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}


  # ============================================================
  # 3. TRIVY - DEPENDENCY / FILESYSTEM SCAN
  # ============================================================
  trivy:
    name: Trivy Vulnerability Scan
    runs-on: ubuntu-latest

    steps:
      - name: Checkout repository
        uses: actions/checkout@v6

      - name: Run Trivy filesystem scan
        uses: aquasecurity/trivy-action@master
        with:
          scan-type: fs
          scan-ref: .
          severity: CRITICAL,HIGH
          ignore-unfixed: true
          exit-code: "1"
          format: table

      - name: Run Trivy SARIF scan
        if: always()
        uses: aquasecurity/trivy-action@master
        with:
          scan-type: fs
          scan-ref: .
          severity: CRITICAL,HIGH
          ignore-unfixed: true
          format: sarif
          output: trivy-results.sarif
          exit-code: "0"

      - name: Upload Trivy SARIF
        if: always()
        uses: github/codeql-action/upload-sarif@v4
        with:
          sarif_file: trivy-results.sarif


  # ============================================================
  # 4. BUILD APPLICATION FOR ZAP
  # ============================================================
  build-for-zap:
    name: Build Application for DAST
    runs-on: ubuntu-latest

    outputs:
      app_ready: ${{ steps.health.outputs.ready }}

    steps:
      - name: Checkout repository
        uses: actions/checkout@v6

      # --------------------------------------------------------
      # IMPORTANT:
      # Replace this section with your application's real
      # install/build/start commands.
      # --------------------------------------------------------

      - name: Setup Node.js
        uses: actions/setup-node@v6
        with:
          node-version: 20
          cache: npm

      - name: Install dependencies
        run: npm ci

      - name: Build application
        run: npm run build --if-present

      - name: Start application
        run: |
          npm run start > app.log 2>&1 &
          echo $! > app.pid

      - name: Wait for application
        id: health
        run: |
          echo "Waiting for application..."

          for i in {1..30}; do
            if curl -fsS http://127.0.0.1:3000 > /dev/null; then
              echo "Application is ready."
              echo "ready=true" >> "$GITHUB_OUTPUT"
              exit 0
            fi

            sleep 2
          done

          echo "Application failed to start."
          cat app.log
          exit 1


  # ============================================================
  # 5. OWASP ZAP - DAST
  # ============================================================
  zap:
    name: OWASP ZAP DAST
    runs-on: ubuntu-latest
    needs: build-for-zap

    steps:
      - name: Checkout repository
        uses: actions/checkout@v6

      - name: Setup Node.js
        uses: actions/setup-node@v6
        with:
          node-version: 20

      - name: Install dependencies
        run: npm ci

      - name: Start application
        run: |
          npm run build --if-present
          npm run start > app.log 2>&1 &
          echo $! > app.pid

      - name: Wait for application
        run: |
          for i in {1..30}; do
            if curl -fsS http://127.0.0.1:3000 > /dev/null; then
              echo "Application is ready."
              exit 0
            fi

            sleep 2
          done

          echo "Application failed to start."
          cat app.log
          exit 1

      - name: OWASP ZAP Baseline Scan
        uses: zaproxy/action-baseline@v0.15.0
        with:
          target: "http://127.0.0.1:3000"
          fail_action: true
          artifact_name: zap-report

      - name: Upload application logs
        if: always()
        uses: actions/upload-artifact@v5
        with:
          name: application-logs
          path: app.log


  # ============================================================
  # FINAL SECURITY GATE
  # ============================================================
  security-gate:
    name: Security Gate
    runs-on: ubuntu-latest

    needs:
      - semgrep
      - gitleaks
      - trivy
      - zap

    if: always()

    steps:
      - name: Evaluate security results
        run: |
          echo "======================================"
          echo "        SECURITY GATE"
          echo "======================================"

          echo "Semgrep:  ${{ needs.semgrep.result }}"
          echo "Gitleaks: ${{ needs.gitleaks.result }}"
          echo "Trivy:    ${{ needs.trivy.result }}"
          echo "ZAP:      ${{ needs.zap.result }}"

          if [[ "${{ needs.semgrep.result }}" != "success" ]]; then
            echo "❌ Semgrep failed"
            exit 1
          fi

          if [[ "${{ needs.gitleaks.result }}" != "success" ]]; then
            echo "❌ Gitleaks failed"
            exit 1
          fi

          if [[ "${{ needs.trivy.result }}" != "success" ]]; then
            echo "❌ Trivy failed"
            exit 1
          fi

          if [[ "${{ needs.zap.result }}" != "success" ]]; then
            echo "❌ OWASP ZAP failed"
            exit 1
          fi

          echo ""
          echo "======================================"
          echo "✅ ALL SECURITY CHECKS PASSED"
          echo "======================================"
```
